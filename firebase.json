{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "hosting": {
    "public": "project",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/pc/index.html",
        "destination": "/index.html?pc=1",
        "type": 301
      },
      {
        "source": "/pc",
        "destination": "/index.html?pc=1",
        "type": 301
      }
    ]
  }
}